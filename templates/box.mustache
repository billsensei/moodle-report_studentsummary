{{!
    @template report_studentsummary/box

    A single key-figure box of the student summary report.

    Context variables required for this template:
    * boxclass - Colour modifier, e.g. ss-box-blue
    * boxid - Unique id used for the heading
    * heading - Box heading
    * hasfigure - Whether a key figure is shown
    * figure - Key figure
    * figurelabel - Text label for the figure
    * hasitems - Whether a breakdown follows
    * items - Breakdown rows (label, value)
    * note - Optional note
    * wide - Whether the box spans two columns

    Example context (json):
    {
        "boxclass": "ss-box-blue",
        "boxid": "ss-activities",
        "heading": "Activities completed",
        "hasfigure": true,
        "figure": "12",
        "figurelabel": "completed",
        "hasitems": true,
        "items": [{"label": "Assignments", "value": 5}, {"label": "Quizzes", "value": 7}],
        "note": ""
    }
}}
<section class="ss-box {{boxclass}}{{#wide}} ss-span-2{{/wide}}" aria-labelledby="{{boxid}}-heading">
    <h2 class="ss-box-heading" id="{{boxid}}-heading">{{heading}}</h2>
    {{#hasfigure}}
    <p class="ss-figure"><span class="ss-figure-value">{{figure}}</span> <span class="ss-figure-label">{{figurelabel}}</span></p>
    {{/hasfigure}}
    {{#hasitems}}
    <ul class="ss-list">
        {{#items}}
        <li><span class="ss-list-label">{{label}}</span> <span class="ss-list-value">{{value}}</span></li>
        {{/items}}
    </ul>
    {{/hasitems}}
    {{#note}}<p class="ss-note">{{note}}</p>{{/note}}
</section>
