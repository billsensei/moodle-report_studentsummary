{{!
    @template report_studentsummary/report

    The single student summary page: a print button above one summary.

    Context variables required for this template:
    * Everything listed in report_studentsummary/summary

    Example context (json):
    {
        "idprefix": "",
        "fullname": "Ada Lovelace",
        "pictureurl": "https://example.com/pix/u/f1.png",
        "sitename": "Example site",
        "reportdate": "23/10/26",
        "hasrange": false,
        "range": "All time",
        "colourstyle": "",
        "kpis": [],
        "breakdowns": [],
        "coursecount": 0,
        "hascourses": false,
        "courses": [],
        "hasmorecourses": false,
        "morecourses": 0,
        "grades": []
    }
}}
<div class="ss-noprint text-end mb-3">
    <button type="button" class="btn btn-secondary" data-action="report_studentsummary-print">{{#str}} printreport, report_studentsummary {{/str}}</button>
</div>
{{> report_studentsummary/summary}}
{{#js}}
    require(['report_studentsummary/print'], function(print) {
        print.init();
    });
{{/js}}
