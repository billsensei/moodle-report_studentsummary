{{!
    @template report_studentsummary/course

    All student summaries of a course: a toolbar and one A4 sheet per student, each printed on its own page.

    Context variables required for this template:
    * hasstudents, students (id, fullname, selectlabel, summary - see report_studentsummary/summary)
    * count - Number of students in total (all pages)
    * pagingbar - Pre-rendered paging bar HTML, may be empty
    * reacttoolbar - Mount point of the React toolbar (Moodle 5.3+), empty to use the Bootstrap toolbar

    Example context (json):
    {
        "hasstudents": true,
        "count": 1,
        "pagingbar": "",
        "reacttoolbar": "",
        "students": [{
            "id": 7,
            "fullname": "Ada Lovelace",
            "selectlabel": "Print Ada Lovelace",
            "summary": {
                "idprefix": "u7-",
                "namelevel": 3,
                "boxlevel": 4,
                "fullname": "Ada Lovelace",
                "pictureurl": "https://example.com/pix/u/f1.png",
                "sitename": "Example site",
                "reportdate": "23/10/26",
                "hasrange": false,
                "range": "All time",
                "colourstyle": "",
                "kpis": [],
                "breakdowns": [],
                "coursecount": 0,
                "hascourses": false,
                "courses": [],
                "hasmorecourses": false,
                "morecourses": 0,
                "grades": []
            }
        }]
    }
}}
<div class="report-studentsummary-course" data-region="report_studentsummary-course">
    {{#hasstudents}}
    {{#reacttoolbar}}
    <div class="ss-noprint mb-3">{{{reacttoolbar}}}</div>
    {{/reacttoolbar}}
    {{^reacttoolbar}}
    <div class="ss-noprint d-flex flex-wrap align-items-center gap-3 mb-3">
        <div class="form-check mb-0">
            <input class="form-check-input" type="checkbox" id="ss-select-all" data-action="report_studentsummary-selectall" checked>
            <label class="form-check-label" for="ss-select-all">{{#str}} selectall, report_studentsummary {{/str}}</label>
        </div>
        <span class="text-muted" data-region="report_studentsummary-selectedcount" aria-live="polite"></span>
        <button type="button" class="btn btn-primary ms-auto" data-action="report_studentsummary-printselected">{{#str}} printselected, report_studentsummary {{/str}}</button>
    </div>
    {{/reacttoolbar}}
    {{/hasstudents}}
    {{^hasstudents}}
    <p class="ss-noprint alert alert-info">{{#str}} nostudents, report_studentsummary {{/str}}</p>
    {{/hasstudents}}

    {{#students}}
    <div class="ss-sheet" data-region="report_studentsummary-sheet">
        <div class="ss-noprint d-flex align-items-center gap-3 mt-4 mb-2">
            <div class="form-check mb-0">
                <input class="form-check-input" type="checkbox" id="ss-select-{{id}}" data-action="report_studentsummary-select" checked>
                <label class="form-check-label" for="ss-select-{{id}}">{{selectlabel}}</label>
            </div>
            <button type="button" class="btn btn-secondary btn-sm ms-auto" data-action="report_studentsummary-printone">{{#str}} printthisone, report_studentsummary {{/str}}<span class="visually-hidden"> {{fullname}}</span></button>
        </div>
        {{#summary}}
            {{> report_studentsummary/summary}}
        {{/summary}}
    </div>
    {{/students}}

    <div class="ss-noprint mt-3">{{{pagingbar}}}</div>
</div>
{{#js}}
    require(['report_studentsummary/course'], function(course) {
        course.init();
    });
{{/js}}
