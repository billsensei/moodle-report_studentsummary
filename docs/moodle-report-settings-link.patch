+declare(strict_types=1);
+
+namespace core\plugininfo;
+
+use advanced_testcase;
+use core_plugin_manager;
+
+/**
+ * Unit tests for the report plugininfo class
+ *
+ * @package     core
+ * @copyright   2026 Moodle contributors
+ * @license     http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
+ */
+#[\PHPUnit\Framework\Attributes\CoversClass(\core\plugininfo\report::class)]
+final class report_test extends advanced_testcase {
+
+    /**
+     * Test the settings section name.
+     */
+    public function test_get_settings_section_name(): void {
+        $plugin = core_plugin_manager::instance()->get_plugin_info('report_eventlist');
+        $this->assertSame('reporteventlist', $plugin->get_settings_section_name());
+    }
+
+    /**
+     * Test the settings URL of a report that has a settings page.
+     */
+    public function test_get_settings_url_with_settings_page(): void {
+        global $CFG;
+        require_once($CFG->libdir . '/adminlib.php');
+        $this->resetAfterTest();
+        $this->setAdminUser();
+
+        // No core report has settings, so add a page for one of them to the admin tree.
+        $info = core_plugin_manager::instance()->get_plugin_info('report_outline');
+        $page = new \admin_settingpage($info->get_settings_section_name(), 'Outline', 'moodle/site:config');
+        admin_get_root()->add('reportplugins', $page);
+
+        $url = $info->get_settings_url();
+        $this->assertInstanceOf(\moodle_url::class, $url);
+        $this->assertEquals(
+            new \moodle_url('/admin/settings.php', ['section' => 'reportoutline']),
+            $url
+        );
+    }
+
+    /**
+     * Test that reports without a settings page have no settings URL.
+     *
+     * @param string $plugin
+     */
+    #[\PHPUnit\Framework\Attributes\DataProvider('get_settings_url_none_provider')]
+    public function test_get_settings_url_without_settings_page(string $plugin): void {
+        global $CFG;
+        require_once($CFG->libdir . '/adminlib.php');
+        $this->resetAfterTest();
+        $this->setAdminUser();
+
+        $info = core_plugin_manager::instance()->get_plugin_info($plugin);
+        $this->assertNull($info->get_settings_url());
+    }
+
+    /**
+     * Data provider for test_get_settings_url_without_settings_page.
+     *
+     * @return array
+     */
+    public static function get_settings_url_none_provider(): array {
+        return [
+            // The log report only registers an external page that links to the report itself.
+            'Report with only an external page' => ['report_log'],
+            'Report without any admin page' => ['report_outline'],
+        ];
+    }
+}
